DATABASE_URL=postgresql+psycopg://doc:doc@localhost:5432/doc
CELERY_BROKER_URL=amqp://doc:doc@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0
STORAGE_DIR=./data/uploads
# Offline mode recognizes the supplied fixture, always requests human review.
LLM_MODE=mock
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
AGENT_ENABLED=true
# Opt in to strict rules-first extraction for a narrow Chinese TXT format.
RULES_FIRST_ENABLED=false
AGENT_MAX_ROUNDS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TOKENS=64000
AGENT_MAX_SECONDS=180
# Optional shared token for all API routes except health and the static demo page.
API_TOKEN=
